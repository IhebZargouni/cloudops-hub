# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Node environment (development | test | production)
NODE_ENV=development

# Application port
PORT=5000

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Development database URL
# For local development (outside Docker):
# DATABASE_URL="mysql://cloudops:cloudops123@localhost:3306/cloudops_hub"
# For Docker Compose:
DATABASE_URL="mysql://cloudops:cloudops123@mysql:3306/cloudops_hub"

# ============================================
# JWT CONFIGURATION (for future use)
# ============================================

# JWT Access Token Secret
JWT_SECRET=your_jwt_secret_here

# JWT Refresh Token Secret
JWT_REFRESH_SECRET=your_refresh_secret_here

# ============================================
# AWS CONFIGURATION (for future deployment)
# ============================================

# AWS Region
# AWS_REGION=eu-west-1

# S3 Bucket (for file uploads)
# S3_BUCKET=cloudops-hub-uploads

# CloudWatch Log Group
# CLOUDWATCH_LOG_GROUP=/cloudops-hub/backend